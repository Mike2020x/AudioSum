rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSession(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.transcript is string && data.transcript.size() <= 100000 &&
             data.createdAt == request.time;
    }

    match /sessions/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSession(request.resource.data);
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         // Action: Update notes
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']) ||
                         // Action: Update title
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
                       );
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
  }
}
